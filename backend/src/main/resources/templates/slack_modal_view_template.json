{
  "type": "modal",
  "callback_id": "modal-identifier",
  "title": {
    "type": "plain_text",
    "text": "Customize SpotMyStatus"
  },
  "submit": {
    "type": "plain_text",
    "text": "Submit"
  },
  "blocks": [
    {
      "type": "header",
      "text": {
        "type": "plain_text",
        "text": "Hey there! SpotMyStatus has a new home"
      }
    },
    {
      "block_id": "first_divider_block",
      "type": "divider"
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": ":rocket: <https://spotmystatus.com|*Sign up*> to enjoy rich features:"
      }
    },
    {
      "type": "rich_text",
      "elements": [
        {
          "type": "rich_text_section",
          "elements": [
            {
              "type": "text",
              "text": " "
            }
          ]
        },
        {
          "type": "rich_text_list",
          "style": "bullet",
          "indent": 0,
          "elements": [
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Custom emojis for your Slack status "
                },
                {
                  "type": "emoji",
                  "name": "the_horns"
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Beautiful dashboard for more insights into your listening habits"
                },
                {
                  "type": "emoji",
                  "name": "chart_with_upwards_trend"
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Updates for both music and podcasts "
                },
                {
                  "type": "emoji",
                  "name": "notes"
                },
                {
                  "type": "emoji",
                  "name": "studio_microphone"
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Custom sync schedule (e.g. 9am to 6pm) "
                },
                {
                  "type": "emoji",
                  "name": "clock1"
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "See what your teammates on Spotmystatus are listening to "
                },
                {
                  "type": "emoji",
                  "name": "headphones"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}